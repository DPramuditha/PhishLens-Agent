# =============================================================================
# PhishLens Agent — Frontend Environment Configuration Template
# =============================================================================
# Copy this file to frontend/.env:
#   cp frontend/.env.example frontend/.env
# =============================================================================

# Django REST API Backend Base URL
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Client Credentials (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login
